# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
PORT=3000

# Reasoning depth: low | medium | high | xhigh | max
# "high" is the default and a good balance. "xhigh" digs harder on thin-coverage
# small caps and costs more; "medium" is noticeably cheaper for large, well-covered names.
RESEARCH_EFFORT=high

# Max web searches per report. Raise for small caps that need more digging.
MAX_SEARCHES=14
