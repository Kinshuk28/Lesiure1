# --- Pick ONE provider -------------------------------------------------------

# Google Gemini — the free option. Get a key at https://aistudio.google.com/apikey
# (sign in with Google, "Create API key"; no card required). The free tier has
# daily request limits — see https://aistudio.google.com/rate-limit
GEMINI_API_KEY=

# Anthropic — paid, no free tier beyond the small signup credit.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Force a provider when both keys are present. Otherwise Gemini wins if its key
# is set, else Anthropic.
# PROVIDER=gemini

# --- Optional ----------------------------------------------------------------

PORT=3000

# Gemini model. Must be a Gemini 3 series model — older Gemini models cannot
# combine Google Search grounding with structured JSON output and will error.
# GEMINI_MODEL=gemini-3.6-flash

# Anthropic only. Reasoning depth: low | medium | high | xhigh | max
RESEARCH_EFFORT=high

# Anthropic only. Max web searches per report.
MAX_SEARCHES=14
